# Configuração SMTP usada para enviar os e-mails do formulário de contato
# via Nodemailer. Preencha com os dados da caixa seguranca.ativaocupacional@gmail.com
# em um arquivo .env.local (nunca commitar os valores reais — .env.local já
# está no .gitignore).

# Host do servidor SMTP (ex: smtp.gmail.com)
SMTP_HOST=

# Porta do servidor SMTP (ex: 465 para SSL, 587 para STARTTLS)
SMTP_PORT=

# "true" se a conexão usa SSL/TLS direto (geralmente porta 465),
# "false" caso use STARTTLS (geralmente porta 587)
SMTP_SECURE=

# Usuário SMTP (geralmente o próprio e-mail da caixa)
SMTP_USER=

# Senha da caixa de e-mail SMTP
SMTP_PASSWORD=
