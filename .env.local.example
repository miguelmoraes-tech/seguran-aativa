# Variáveis de ambiente necessárias em produção.
# Copie este arquivo para .env.local e preencha com os valores reais
# (ou configure-as diretamente no painel "Setup Node.js App" do cPanel).
# NUNCA commitar nem enviar este arquivo com valores reais preenchidos.

# Host do servidor SMTP usado para enviar os e-mails do formulário de contato.
SMTP_HOST=smtp.gmail.com

# Porta do servidor SMTP (465 para SSL, 587 para STARTTLS).
SMTP_PORT=587

# "true" se a conexão usa SSL/TLS direto (porta 465),
# "false" caso use STARTTLS (porta 587).
SMTP_SECURE=false

# Usuário SMTP (geralmente o próprio e-mail da caixa que envia).
SMTP_USER=seguranca.ativaocupacional@gmail.com

# Senha da caixa de e-mail SMTP.
SMTP_PASSWORD=
